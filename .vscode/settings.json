{
    "cmake.configureOnOpen": true,
    "cmake.generator": "Ninja",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "xaver.clang-format",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--compile-commands-dir=${workspaceFolder}/build/clang/debug/"
    ],
    "files.associations": {
        "*.tpp": "cpp"
    }
}